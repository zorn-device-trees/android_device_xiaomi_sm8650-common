type vendor_touch_init_shell, domain;
type vendor_touch_init_shell_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(vendor_touch_init_shell)

allow vendor_touch_init_shell vendor_shell_exec:file entrypoint;
allow vendor_touch_init_shell vendor_toolbox_exec:file { rx_file_perms execute_no_trans };

# init.panel_info.sh: read panel/touch info and publish vendor.panel.* props
allow vendor_touch_init_shell sysfs_touch_hostprocess:file r_file_perms;
set_prop(vendor_touch_init_shell, vendor_fp_prop)
set_prop(vendor_touch_init_shell, vendor_fp_info_prop)
