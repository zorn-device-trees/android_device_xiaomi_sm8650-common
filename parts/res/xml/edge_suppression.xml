<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/edgesuppression_title">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="edgesuppression_enable"
        android:title="@string/edgesuppression_enable" />

    <SeekBarPreference
        android:key="edgesuppression_width_pixels"
        android:title="@string/edgesuppression_width_title"
        android:defaultValue="@integer/edge_suppression_condition_default"
        android:max="@integer/edge_suppression_condition_max"
        android:dependency="edgesuppression_enable" />

</PreferenceScreen>
